# The portable mind core, paths relative to kernel/. Included by the Circle
# kernel's Makefile and by kernel/host/Makefile; both add -I mind.
MIND_SRCS = \
	mind/util/fmt.cpp \
	mind/util/log.cpp \
	mind/link/body_state.cpp \
	mind/link/consts.cpp \
	mind/link/goals.cpp \
	mind/link/names.cpp \
	mind/link/serial_link.cpp \
	mind/planner/errors.cpp \
	mind/planner/model.cpp \
	mind/planner/patterns.cpp \
	mind/planner/plan.cpp \
	mind/planner/walker.cpp \
	mind/proto/crc16.c \
	mind/proto/kilo_frame.c

# The laptop interface (docs/fast-boot.md §5, P2): RAM log ring and host server.
MIND_SRCS += \
	mind/util/logring.cpp \
	mind/net/host_frame.cpp \
	mind/net/host_server.cpp \
	mind/net/host_secure.cpp \
	mind/net/host_cal.cpp

# Who may talk to the mind (kernel/README.md "Who may talk to Kilo: keys"):
# Monocypher (vendored, byte-identical upstream C) under the host channel's
# Noise layer (net/noise).
MIND_SRCS += \
	mind/third_party/monocypher/monocypher.c \
	mind/net/noise.cpp

# Body flashing (docs/fast-boot.md §6, P4): the image, its CRC-32 and
# manifest, the STK500v1 flasher, and the boot-time flash from the SD card.
MIND_SRCS += \
	mind/flash/crc32.cpp \
	mind/flash/image.cpp \
	mind/flash/flasher.cpp \
	mind/flash/cardflash.cpp

# The mind's own kernel onto its SD card (UPDATE_*): the image, its checks
# and the write through the platform's KernelStore.
MIND_SRCS += \
	mind/update/updater.cpp

# ---- P3 (docs/fast-boot.md): tricks, perception, behaviour, remote and the Mind --------
MIND_SRCS += \
	mind/tricks/model.cpp \
	mind/tricks/library.cpp \
	mind/tricks/library.gen.cpp \
	mind/tricks/player.cpp \
	mind/perception/ultrasonic.cpp \
	mind/perception/imu.cpp \
	mind/perception/percepts.cpp \
	mind/behaviour/random.cpp \
	mind/behaviour/drives.cpp \
	mind/behaviour/personality.gen.cpp \
	mind/behaviour/tree.cpp \
	mind/behaviour/selector.cpp \
	mind/behaviour/library.cpp \
	mind/behaviour/runner.cpp \
	mind/behaviour/alive.cpp \
	mind/guard/guard.cpp \
	mind/remote/client.cpp \
	mind/remote/keys.cpp \
	mind/remote/remote.cpp \
	mind/power/battery.cpp \
	mind/power/sleep.cpp \
	mind/mind.cpp

# The flight recorder (record/): every frame, log line, walk and trick in RAM, the card saver, the metrics.
MIND_SRCS += \
	mind/record/flight.cpp \
	mind/record/saver.cpp \
	mind/net/host_records.cpp \
	mind/record/recorder.cpp

# Finding Kilo by name (net/mdns.h): the mDNS responder's datagrams; the
# Circle kernel's CKiloMdns task (src/net.cpp) owns its socket.
MIND_SRCS += \
	mind/net/mdns.cpp

# Kilo's sounds (sound/, docs/sound.md): the player and the renderer. The
# table of sounds (sound::kSounds) is generated by tools/pack_sounds.py from
# kernel/sounds/*.wav into each build's own directory (kernel/Makefile,
# kernel/host/Makefile), not listed here.
MIND_SRCS += \
	mind/sound/render.cpp \
	mind/sound/player.cpp

# Kilo measures himself (measure/, docs/self-measurement.md): the remote's B1.
MIND_SRCS += \
	mind/measure/script.cpp \
	mind/measure/measure.cpp
